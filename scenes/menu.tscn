[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.92, 0.88, 0.78, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -190.0
offset_right = 260.0
offset_bottom = 190.0
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
theme_override_colors/font_color = Color(0.15, 0.12, 0.1, 1)
text = "墨境百家"
horizontal_alignment = 1

[node name="Sub" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.3, 0.27, 0.22, 1)
text = "水墨幸存 · 首卷墨家书院 — WASD移动 全自动战斗"
horizontal_alignment = 1

[node name="Best" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "新卷未书"
horizontal_alignment = 1

[node name="Start" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)
theme_override_font_sizes/font_size = 28
text = "落笔开始 (Enter)"

[node name="Quit" type="Button" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "退出"

[connection signal="pressed" from="VBox/Start" to="." method="_on_start"]
[connection signal="pressed" from="VBox/Quit" to="." method="_on_quit"]
